<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>NjordWarehouseKeeper</AssemblyName>
    <RootNamespace>NjordWarehouseKeeper</RootNamespace>
    <Version>1.3.3</Version>
    <Authors>GitMCP</Authors>
    <Description>Njord, Warehouse Keeper. Lists and moves items across nearby chests.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- See the Bicicreta project file for why Jotunn's build assets are excluded. -->
    <PackageReference Include="JotunnLib" Version="2.30.0" ExcludeAssets="build" />
  </ItemGroup>

  <ItemGroup>
    <!-- Language catalogs travel inside the single plugin DLL. Add a new JSON file
         named after the Valheim language to extend the catalog without code changes. -->
    <EmbeddedResource Include="Localization\*.json" />
  </ItemGroup>

</Project>
