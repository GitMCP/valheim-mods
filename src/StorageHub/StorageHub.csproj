<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>StorageHub</AssemblyName>
    <RootNamespace>StorageHub</RootNamespace>
    <Version>1.1.0</Version>
    <Authors>GitMCP</Authors>
    <Description>Njord, a warehouse keeper who lists and moves items across nearby containers.</Description>
