<Project>

  <!--
    Referencing netstandard2.0 packages (BepInEx, HarmonyX) makes the SDK copy ~95
    netstandard facade shims next to the built plugin. Valheim's Mono runtime already
    ships those, and BepInEx tries to load everything in the plugins folder, so anyone
    who copies the whole output directory into plugins gets a broken install. Keep the
    facades as compile-time references and drop them from the output.
  -->
  <Target Name="ExcludeNETStandardFacadesFromOutput"
          AfterTargets="ImplicitlyExpandNETStandardFacades">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(_NETStandardLibraryNETFrameworkLib)" />
    </ItemGroup>
  </Target>

  <Target Name="ValidateGameReferences" BeforeTargets="BeforeResolveReferences">
    <Error Condition="!Exists('$(ValheimManagedDir)assembly_valheim.dll')"
           Text="Valheim reference assemblies not found at '$(ValheimManagedDir)'. Run tools/fetch-game-libs.sh, or point ValheimInstall at a game install in Environment.props." />
  </Target>

  <!-- `dotnet build -t:Deploy` drops the plugin straight into a local BepInEx install. -->
  <Target Name="Deploy" DependsOnTargets="Build">
    <Error Condition="'$(ModDeployPath)' == ''"
           Text="Nowhere to deploy to. A Valheim install in Steam's default location with BepInEx already installed is found automatically; otherwise pass -p:ModDeployPath=&lt;path to BepInEx/plugins&gt; or set ModDeployPath in Environment.props." />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(AssemblyName).pdb"
          DestinationFolder="$(ModDeployPath)"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
    <Message Importance="high" Text="Deployed $(AssemblyName) to $(ModDeployPath)" />
  </Target>

  <!-- `dotnet build -t:Package` builds an uploadable Thunderstore archive. -->
  <Target Name="Package" DependsOnTargets="Build">
    <PropertyGroup>
      <ThunderstoreDir>$(MSBuildProjectDirectory)/thunderstore/</ThunderstoreDir>
      <PackageStageDir>$(BaseIntermediateOutputPath)thunderstore/</PackageStageDir>
      <PackageZipPath>$(RepoRoot)artifacts/$(AssemblyName)-$(Version).zip</PackageZipPath>
    </PropertyGroup>

    <!-- Version lives in the mod's project file only; the manifest copy is stamped on
         the way into the archive so the two can never disagree. -->
    <PropertyGroup>
      <ManifestTemplate>$([System.IO.File]::ReadAllText('$(ThunderstoreDir)manifest.json'))</ManifestTemplate>
      <StampedManifest>$([System.Text.RegularExpressions.Regex]::Replace('$(ManifestTemplate)', '("version_number"\s*:\s*")[^"]*(")', '${1}$(Version)${2}'))</StampedManifest>
    </PropertyGroup>

    <RemoveDir Directories="$(PackageStageDir)" />
    <MakeDir Directories="$(PackageStageDir)" />
    <!-- Thunderstore reads a CHANGELOG.md if there is one and ignores its absence, so
         it is copied only when the mod keeps one. -->
    <ItemGroup>
      <PackageFile Include="$(TargetPath);$(ThunderstoreDir)icon.png;$(ThunderstoreDir)README.md" />
      <PackageFile Include="$(ThunderstoreDir)CHANGELOG.md" Condition="Exists('$(ThunderstoreDir)CHANGELOG.md')" />
    </ItemGroup>

    <Copy SourceFiles="@(PackageFile)" DestinationFolder="$(PackageStageDir)" />
    <WriteLinesToFile File="$(PackageStageDir)manifest.json"
                      Lines="$(StampedManifest)"
                      Overwrite="true" />
    <MakeDir Directories="$(RepoRoot)artifacts" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)"
                  DestinationFile="$(PackageZipPath)"
                  Overwrite="true" />
    <Message Importance="high" Text="Packaged $(PackageZipPath)" />
  </Target>

</Project>
